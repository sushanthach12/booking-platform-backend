# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8001
CORS_ORIGIN=*

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=booking_platform
# Never set POSTGRES_SYNCHRONIZE=true in production
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_SSL=false
# Required when POSTGRES_SSL=true
# POSTGRES_CA_CERTIFICATE=

# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_URL takes precedence over host/port when set (e.g. rediss://... for TLS)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Tuning (all optional — defaults shown)
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_RETRY_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=2000
REDIS_MAX_RETRIES=0
REDIS_KEEP_ALIVE=30000
REDIS_STARTUP_TIMEOUT=15000
REDIS_ENABLE_READY_CHECK=true
REDIS_LAZY_CONNECT=false

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-deploy
# Access token TTL — NestJS JwtModule format (e.g. 15m, 1h, 86400)
JWT_EXPIRY=1h
# Google OAuth Web client id — used as the audience to verify Google ID tokens.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the web app.
GOOGLE_CLIENT_ID=

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Presigned URL TTL in seconds (default: 300)
R2_PRESIGN_EXPIRY_SECONDS=300

# ─── Notification Service (OTP emails) ──────────────────────────────────────
# Base URL of the notification microservice; OTPs are sent via
# POST {url}/api/notifications/send with the x-api-key header.
# When unset in development, the OTP is logged to the console instead.
NOTIFICATION_SERVICE_URL=http://localhost:4000
NOTIFICATION_SERVICE_API_KEY=
APP_NAME=Stayly
# Used as appUrl in OTP emails and for password-reset links
FRONTEND_URL=http://localhost:3000

# ─── Email (not yet wired) ───────────────────────────────────────────────────
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=
